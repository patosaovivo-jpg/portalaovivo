  "commercial_paragraphs": {
    "alcance": {
      "5_6": "O crescimento de eventos regionais como esse demonstra a forca das programacoes locais e o interesse do publico em acompanhar de perto a agenda cultural da regiao.",
      "7_8": "Para quem nao consegue estar no local, uma transmissao ao vivo amplia o alcance do evento e permite acompanhar a programacao de qualquer lugar.",
      "9_10": "Eventos como esse mostram o potencial de levar a experiencia para alem do publico presente: com transmissao ao vivo e cobertura audiovisual, quem esta em outra cidade ou trabalhando tambem acompanha cada momento."
    },
    "audiencia": {
      "5_6": "O interesse do publico por esse tipo de conteudo reforca como a programacao regional conquista cada vez mais espectadores.",
      "7_8": "A transmissao ao vivo permite levar essa programacao para uma audiencia ainda maior, fora dos limites do espaco fisico.",
      "9_10": "Audiências que acompanham esse tipo de conteudo crescem quando existe transmissao profissional: alem do publico presente, ha milhares de pessoas esperando acompanhar online."
    },
    "esporte": {
      "5_6": "O esporte regional movimenta torcidas em toda a regiao e reforca o interesse pela competicao local.",
      "7_8": "A cobertura esportiva com transmissao ao vivo e producao multicamera permite que a torcida acompanhe cada lance de onde estiver.",
      "9_10": "Com transmissao esportiva profissional, cada lance, analise e emocao da partida chegam para quem nao consegue ir ao estadio - ampliando o alcance e o valor da competicao."
    },
    "visibilidade": {
      "5_6": "Eventos movimentam marcas e patrocinadores, que buscam cada vez mais visibilidade junto ao publico regional.",
      "7_8": "A exposicao de marcas durante eventos ganha ainda mais forca quando a transmissao amplia o alcance para alem do publico presente.",
      "9_10": "Com transmissao ao vivo e conteudo para redes sociais, marcas e patrocinadores expandem a visibilidade muito alem do publico presencial, tornando cada investimento mais eficiente."
    },
    "empresarial": {
      "5_6": "Eventos empresariais e tecnicos movimentam profissionais e empresas interessadas em conteudo e conexao.",
      "7_8": "Uma cobertura audiovisual e uma transmissao hibrida permitem que a programacao alcance participantes que nao puderam estar presentes.",
      "9_10": "Para eventos empresariais, a transmissao hibrida e a producao de conteudo estendem o alcance: o publico que nao participa presencialmente ainda acompanha e consume o conteudo depois."
    }
  },

